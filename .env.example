# Copia este archivo a .env (`make env`) y ajusta los valores.
# .env está en .gitignore: nunca se versiona.

# Entorno de ejecución: local | test | prod
APP_ENV=local

# Logging: nivel (DEBUG, INFO, WARNING, ERROR) y formato (text | json)
LOG_LEVEL=INFO
LOG_FORMAT=text

# PostgreSQL (datos de tickets, eventos y resultados).
# Valores solo para desarrollo local: cámbialos fuera de tu máquina.
# Puerto 5433 en el host para no chocar con otro Postgres local (el contenedor usa 5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=support
POSTGRES_USER=mlplatform
POSTGRES_PASSWORD=mlplatform_local

# MLflow (tracking + model registry). Los clientes solo necesitan esta URL: el servidor
# hace de intermediario para los artefactos.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PORT=5000

# Credenciales del almacenamiento de artefactos (SeaweedFS, API S3). Solo las usa el
# servidor de MLflow dentro de Docker. Valores solo para desarrollo local.
ARTIFACTS_ACCESS_KEY=mlplatform
ARTIFACTS_SECRET_KEY=mlplatform_local_secret

# Serving (API de predicción). Cada cuántos segundos revisa si cambió el champion.
SERVING_PORT=8000
SERVING_REFRESH_SECONDS=15
