# Copia este archivo a .env (`make env`) y ajusta los valores.
# .env está en .gitignore: nunca se versiona.

# Entorno de ejecución: local | test | prod
APP_ENV=local

# Logging: nivel (DEBUG, INFO, WARNING, ERROR) y formato (text | json)
LOG_LEVEL=INFO
LOG_FORMAT=text

# PostgreSQL (datos de tickets, eventos y resultados).
# Valores solo para desarrollo local: cámbialos fuera de tu máquina.
# Puerto 5433 en el host para no chocar con otro Postgres local (el contenedor usa 5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=support
POSTGRES_USER=mlplatform
POSTGRES_PASSWORD=mlplatform_local
